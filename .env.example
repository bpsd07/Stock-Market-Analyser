# ==============================================================================
# AI-POWERED INDIAN MARKET TRADING & RESEARCH PLATFORM - ENVIRONMENT CONFIG
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# Note: The platform operates with free/public data by default (Yahoo Finance,
# NSE Archives, Google Finance, SQLite, local paper trading) even without paid API keys.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-jwt-signing
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Defaults to SQLite zero-setup mode if PostgreSQL is not running.
DATABASE_URL=sqlite+aiosqlite:///./data/trading_platform.db
# For production PostgreSQL + TimescaleDB:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db

# Cache & Worker Queue
# Defaults to in-memory cache if Redis is not configured.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# AI Provider API Keys (Configure at least one for AI Analyst Agents)
# Google Gemini (Default recommended for high performance & structured output)
GEMINI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# DeepSeek / OpenRouter / Local Ollama (OpenAI-compatible)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Market Data Providers (Optional - Public scrapers & Yahoo Finance are built-in)
# Paid market data API (e.g. TrueData, GlobalDataFeeds, MarketQuote)
MARKET_DATA_API_KEY=
# News API (e.g. NewsAPI, Tavily, SerpAPI for real-time web news)
NEWS_API_KEY=
TAVILY_API_KEY=
# AlphaVantage / FinancialModelingPrep for global macro & fundamentals
FINANCIAL_MODELING_PREP_API_KEY=

# Indian Broker Execution Credentials (PAPER TRADING IS DEFAULT)
# Mode: "RESEARCH" | "PAPER" | "LIVE" (LIVE requires explicit user confirmation)
EXECUTION_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Zerodha Kite Connect (Optional - for live Zerodha data and execution)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_REDIRECT_URL=http://localhost:8000/api/v1/broker/zerodha/callback

# Angel One SmartAPI (Optional)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_KEY=

# DhanHQ API (Optional)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox API v2 (Optional)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/broker/upstox/callback

# Risk Management Parameters
MAX_PORTFOLIO_RISK_PER_TRADE=0.01
MAX_SECTOR_ALLOCATION=0.25
MAX_SINGLE_STOCK_ALLOCATION=0.10
DEFAULT_STOP_LOSS_ATR_MULTIPLE=2.0
MIN_RISK_REWARD_RATIO=2.0
